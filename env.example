# Copy this file to .env and fill in the values. Never commit .env.

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# Judge0 (base url, no trailing path)
JUDGE0_CE_ENDPOINT=http://localhost:2358
# Optional, only if your Judge0 needs auth headers, as one json object:
# JUDGE0_CE_AUTH_HEADERS={"X-Auth-Token": "your-token"}

# Optional: DEBUG, INFO (default), WARNING, ERROR
# LOG_LEVEL=INFO
